<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{% if title %}{{ title }} · {% endif %}Music Hub</title>
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/tokens.css">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">Music Hub</a>
    <nav>
      <a href="/"{% if nav == "overview" %} aria-current="page"{% endif %}>Overview</a>
      <a href="/units/"{% if nav == "units" %} aria-current="page"{% endif %}>Units</a>
      <a href="/minis/"{% if nav == "minis" %} aria-current="page"{% endif %}>Mini lessons</a>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch light or dark mode" title="Light or dark mode">◐</button>
  </header>
  <main>
    {{ content | safe }}
  </main>
  {% if site.currentTerm %}<script id="term" type="application/json">{"starts":"{{ site.currentTerm.starts }}","weeks":{{ site.currentTerm.weeks or 10 }}}</script>{% endif %}
  <script src="/assets/site.js"></script>
</body>
</html>
